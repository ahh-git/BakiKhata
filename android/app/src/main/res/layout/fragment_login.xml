<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Centered Glass Card -->
        <LinearLayout
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Inside App Logo (BakiKhata 3) -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app_brand" />

            <!-- Brand Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="BakiKhata"
                android:textColor="@color/ink"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03" />

            <!-- Pill Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_glass_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="স্বচ্ছ বাকি · ডিজিটাল খাতা"
                android:textColor="@color/primary_indigo"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Subtitle Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="দোকানদার এবং কাস্টমারদের জন্য স্মার্ট বাকি ব্যবস্থাপক। কোনো হিসাব মুছে যায় না, শতভাগ স্বচ্ছ ও নিরাপদ।"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <!-- Feature Bullet List (No Emojis) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•  লাইভ ক্লাউড ব্যাকআপ"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="•  QR কোড ও দ্রুত জয়েন"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="•  হোয়াটসঅ্যাপ তাকিদা ও ডিজিটাল রশিদ"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Google Sign-In Button -->
            <LinearLayout
                android:id="@+id/btnGoogleLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_glass_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_google_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Google দিয়ে প্রবেশ করুন"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLoginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/accent_rose"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Note Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Google সাইন-ইন সম্পন্ন হলে স্বয়ংক্রিয়ভাবে অ্যাকাউন্ট যুক্ত হবে।"
                android:textColor="@color/ink_light"
                android:textSize="11sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
