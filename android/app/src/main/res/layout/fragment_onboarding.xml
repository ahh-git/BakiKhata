<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- MODE 1: Role Chooser -->
            <LinearLayout
                android:id="@+id/layoutRoleChoose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="কীভাবে জয়েন করবেন?"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="সাইন আপের আগে এই দুটি অপশন থেকে একটি বেছে নিন। পরে আর রোল বদলানো যাবে না।"
                    android:textColor="@color/ink_muted"
                    android:textSize="13sp" />

                <!-- Shopkeeper Choice Button -->
                <LinearLayout
                    android:id="@+id/btnChooseShop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_glass_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="দোকানদার হিসেবে জয়েন করুন"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="আপনার আইডি ০০০১ থেকে শুরু হবে। কাস্টমারদের বাকি দেখুন, পরিশোধ কনফার্ম করুন।"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Customer Choice Button -->
                <LinearLayout
                    android:id="@+id/btnChooseCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="কাস্টমার হিসেবে জয়েন করুন"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="দোকানের আইডি দিয়ে জয়েন করুন, বাকি লিখুন, WhatsApp-এ পাঠান।"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- MODE 2: Shopkeeper Form -->
            <LinearLayout
                android:id="@+id/layoutShopForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="দোকানদার অ্যাকাউন্ট"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etShopOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_field"
                    android:hint="আপনার নাম"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_light"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etShopName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field"
                    android:hint="দোকানের নাম"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_light"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etShopPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field"
                    android:hint="মোবাইল নম্বর (WhatsApp)"
                    android:inputType="phone"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_light"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSubmitShop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_primary_button"
                    android:paddingVertical="13dp"
                    android:text="দোকান খুলুন"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnBackFromShop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="পেছনে"
                    android:textColor="@color/ink_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- MODE 3: Customer Form -->
            <LinearLayout
                android:id="@+id/layoutCustomerForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="কাস্টমার অ্যাকাউন্ট"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_field"
                    android:hint="আপনার নাম"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_light"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etCustomerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field"
                    android:hint="মোবাইল নম্বর"
                    android:inputType="phone"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_light"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSubmitCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_primary_button"
                    android:paddingVertical="13dp"
                    android:text="কাস্টমার হিসেবে জয়েন"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnBackFromCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="পেছনে"
                    android:textColor="@color/ink_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOnboardingError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/accent_rose"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
