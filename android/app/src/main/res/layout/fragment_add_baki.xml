<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Form Layout -->
        <LinearLayout
            android:id="@+id/layoutAddForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বাকি অ্যাড করুন"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAddShopSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/ink_muted"
                android:textSize="12sp"
                tools:text="দোকান · আইডি 0001" />

            <!-- Live Total Display Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_live_amount_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="লাইভ টোটাল"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvLiveAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="৳—"
                    android:textColor="@color/ink"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Field 1: Item -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="কী খেয়েছেন / কিনেছেন"
                android:textColor="@color/ink_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:hint="যেমন: চা, বিস্কুট"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_light"
                android:textSize="14sp" />

            <!-- Field 2: Qty -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="কতগুলো"
                android:textColor="@color/ink_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:hint="2 বা 1+1"
                android:padding="14dp"
                android:text="1"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_light"
                android:textSize="14sp" />

            <!-- Field 3: Expression -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="টাকা (১০+১০ লিখলে অটো যোগ হবে)"
                android:textColor="@color/ink_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:hint="10+10 বা 50*2"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_light"
                android:textSize="14sp" />

            <!-- Field 4: Note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="নোট (ঐচ্ছিক)"
                android:textColor="@color/ink_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:hint="অতিরিক্ত কথা"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_light"
                android:textSize="14sp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSubmitBaki"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:paddingVertical="13dp"
                android:text="বাকি লিখুন"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAddError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/accent_rose"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Confirmation State Layout -->
        <LinearLayout
            android:id="@+id/layoutDoneConfirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="কনফার্মেশন"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="বাকি যোগ হয়েছে"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDoneItemSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink_muted"
                android:textSize="14sp"
                tools:text="চা · ৳২০ · রবিবার ১০:৩০:০০" />

            <TextView
                android:id="@+id/tvDoneTotalDue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/ink"
                android:textSize="16sp"
                tools:text="এখন মোট বাকি: ৳১২০" />

            <!-- WhatsApp Send Button -->
            <LinearLayout
                android:id="@+id/btnSendWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="13dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_whatsapp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="WhatsApp-এ পাঠান"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoPhoneNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="দোকানদারের নম্বর নেই, তাই WhatsApp খোলা যাচ্ছে না।"
                android:textColor="@color/accent_amber"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Add More Button -->
            <TextView
                android:id="@+id/btnAddMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="আরও বাকি অ্যাড করুন"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
