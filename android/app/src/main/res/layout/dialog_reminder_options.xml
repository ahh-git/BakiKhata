<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CBD5E1" />

    <TextView
        android:id="@+id/tvReminderCustomerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WhatsApp তাগাদা পাঠান"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvReminderCustomerSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="কাস্টমারকে কোন ধরনের বার্তা পাঠাতে চান?"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <!-- 1. Gentle Reminder -->
    <LinearLayout
        android:id="@+id/btnReminderGentle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_button"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_whatsapp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="নম্র ও বিনীত তাগাদা (Gentle Reminder)"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="সুবিধাজনক সময়ে বকেয়া পরিশোধের অনুরোধ বার্তা"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Urgent Reminder -->
    <LinearLayout
        android:id="@+id/btnReminderUrgent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_button"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bell" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="জরুরি তাগাদা (Urgent Notice)"
                android:textColor="@color/accent_rose"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="দ্রুত বকেয়া পরিশোধের জরুরি বিশেষ তাগাদা"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Statement Reminder -->
    <LinearLayout
        android:id="@+id/btnReminderStatement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_button"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_book" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="হিসাবের বিবরণ ও ফর্দ (Full Statement)"
                android:textColor="@color/primary_indigo"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="দোকান ও মোট বাকি টাকার অফিসিয়াল বিবরণ"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Close button -->
    <TextView
        android:id="@+id/btnCancelReminderDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:padding="10dp"
        android:text="বাতিল"
        android:textColor="@color/ink_muted"
        android:textSize="14sp" />

</LinearLayout>
