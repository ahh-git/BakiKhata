<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="দোকানে জয়েন"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="দোকানদারের QR স্ক্যান করুন অথবা ৪ ডিজিট আইডি কোড লিখুন।"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <!-- Scan QR Button (Top Action) -->
            <LinearLayout
                android:id="@+id/btnScanQrCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_chip"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_qr_code" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="দোকানের QR কোড স্ক্যান করুন"
                    android:textColor="@color/primary_indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Divider with "অথবা কোড লিখুন" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2094A3B8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="অথবা কোড লিখুন"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2094A3B8" />
            </LinearLayout>

            <EditText
                android:id="@+id/etJoinShopCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_field"
                android:hint="যেমন: 0001"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_light"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSubmitJoin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_primary_button"
                android:paddingVertical="13dp"
                android:text="কোড দিয়ে জয়েন করুন"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJoinSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="ভাই ভাই স্টোর এ জয়েন হয়েছেন" />

            <TextView
                android:id="@+id/tvJoinError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/accent_rose"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="এই আইডির কোনো দোকান পাওয়া যায়নি।" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
