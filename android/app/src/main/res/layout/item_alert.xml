<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="নতুন বাকি যোগ হয়েছে" />

    <TextView
        android:id="@+id/tvAlertBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ink_muted"
        android:textSize="13sp"
        tools:text="চা — ৳২০" />

    <TextView
        android:id="@+id/tvAlertTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ink_light"
        android:textSize="11sp"
        tools:text="২৮ সেপ্টেম্বর, ২০২৬ · রবিবার · ১০:৩০:০০" />

</LinearLayout>
