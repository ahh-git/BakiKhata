<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="হিস্টোরি"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvHistoryShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="ভাই ভাই স্টোর" />

        <TextView
            android:id="@+id/tvHistoryShopDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_muted"
            android:textSize="12sp"
            tools:text="আইডি 0001 · নম্বর 01700000000" />

        <!-- Total Due Card (Visible for customers) -->
        <LinearLayout
            android:id="@+id/layoutTotalDueCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মোট বাকি"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHistoryTotalDue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="৳১২০" />

            <Button
                android:id="@+id/btnHistoryAddMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_primary_button"
                android:paddingVertical="12dp"
                android:text="আরও বাকি অ্যাড করুন"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PDF Statement Download Button -->
        <LinearLayout
            android:id="@+id/btnExportPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_book" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="অফিসিয়াল PDF স্টেটমেন্ট ডাউনলোড / শেয়ার"
                android:textColor="@color/primary_indigo"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ledger Entries RecyclerView -->
        <TextView
            android:id="@+id/tvEmptyLedger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="কোনো লেনদেন পাওয়া যায়নি।"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLedger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
