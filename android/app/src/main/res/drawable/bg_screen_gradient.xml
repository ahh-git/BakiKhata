<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F6F8FC"
                android:endColor="#EEF3FF"
                android:type="linear" />
        </shape>
    </item>
    <!-- Top-left glowing orb -->
    <item
        android:width="260dp"
        android:height="260dp"
        android:left="-70dp"
        android:top="-70dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#40C7D2FE"
                android:endColor="#00C7D2FE" />
        </shape>
    </item>
    <!-- Top-right purple glow -->
    <item
        android:width="240dp"
        android:height="240dp"
        android:right="-60dp"
        android:top="20dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:startColor="#35F3E8FF"
                android:endColor="#00F3E8FF" />
        </shape>
    </item>
    <!-- Bottom-right sky glow -->
    <item
        android:width="280dp"
        android:height="280dp"
        android:right="-60dp"
        android:bottom="-70dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:startColor="#35BAE6FD"
                android:endColor="#00BAE6FD" />
        </shape>
    </item>
</layer-list>
