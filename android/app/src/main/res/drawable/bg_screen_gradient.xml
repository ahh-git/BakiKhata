<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pristine White Base Surface -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#FAFBFD"
                android:endColor="#F1F5F9"
                android:type="linear" />
        </shape>
    </item>
    <!-- Soft Top Light Glow for Frosted Glass Effect -->
    <item
        android:width="260dp"
        android:height="260dp"
        android:left="-50dp"
        android:top="-50dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#166366F1"
                android:endColor="#006366F1" />
        </shape>
    </item>
    <!-- Soft Middle Glow -->
    <item
        android:width="260dp"
        android:height="260dp"
        android:right="-50dp"
        android:top="160dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#12A855F7"
                android:endColor="#00A855F7" />
        </shape>
    </item>
    <!-- Soft Bottom Glow -->
    <item
        android:width="300dp"
        android:height="300dp"
        android:left="-50dp"
        android:bottom="-70dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#1438BDF8"
                android:endColor="#0038BDF8" />
        </shape>
    </item>
</layer-list>
