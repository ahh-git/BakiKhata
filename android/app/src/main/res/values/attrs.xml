<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="NeonBorderLayout">
        <attr name="neonCornerRadius" format="dimension" />
        <attr name="neonStrokeWidth" format="dimension" />
        <attr name="neonGlowWidth" format="dimension" />
        <attr name="neonDuration" format="integer" />
        <attr name="neonEnabled" format="boolean" />
        <attr name="neonColors" format="enum">
            <enum name="cyberpunk" value="0" />
            <enum name="aurora" value="1" />
            <enum name="emerald" value="2" />
            <enum name="sunset" value="3" />
        </attr>
    </declare-styleable>
</resources>
